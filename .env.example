# Copy this file to `.env` and fill in your own values.
# All of these can live in .env – no need to set them in the terminal or use AWS CLI.

# --- OpenChargeMap API ---
# Get a (free) key from https://openchargemap.org/site/develop/api
OCM_API_KEY=your_openchargemap_api_key_here

# --- AWS credentials (used by Terraform and by the upload script) ---
# Create these in AWS IAM (e.g. IAM user with programmatic access and S3 + IAM permissions).
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=eu-north-1

# --- S3 settings (medallion: bronze / silver / gold) ---
# Name of the S3 bucket you will create with Terraform (must be globally unique)
EV_PIPELINE_S3_BUCKET=ev-charging-pipeline-demo

# --- Databricks credentials (used by Terraform Databricks provider) ---
# These are read via environment variables DATABRICKS_HOST and DATABRICKS_TOKEN.
# Do NOT commit real values; keep them only in your local .env.
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
DATABRICKS_TOKEN=your_databricks_pat_here

